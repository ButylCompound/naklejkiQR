<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_blue"
        android:elevation="4dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@android:color/white"
        app:title="@string/home_settings"
        app:titleTextColor="@android:color/white" />

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SettingsGroupHeader"
            android:text="@string/home_inventory" />

        <LinearLayout android:id="@+id/rowAlleys" style="@style/SettingsRow">
            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_alley_count" />
            <TextView android:id="@+id/alleysValue" style="@style/SettingsRowValue" />
        </LinearLayout>

        <LinearLayout android:id="@+id/rowCustomAlleys" style="@style/SettingsRow" android:layout_marginTop="10dp">
            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_custom_alleys" />
            <TextView android:id="@+id/customAlleysValue" style="@style/SettingsRowValue" />
        </LinearLayout>

        <TextView style="@style/SettingsGroupHeader" android:layout_marginTop="24dp" android:text="@string/home_rw" />

        <LinearLayout android:id="@+id/rowRequesters" style="@style/SettingsRow" android:layout_marginTop="10dp">
            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_requesters" />
            <TextView android:id="@+id/requestersValue" style="@style/SettingsRowValue" />
        </LinearLayout>

        <LinearLayout android:id="@+id/rowManagers" style="@style/SettingsRow" android:layout_marginTop="10dp">
            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_managers" />
            <TextView android:id="@+id/managersValue" style="@style/SettingsRowValue" />
        </LinearLayout>

        <TextView style="@style/SettingsGroupHeader" android:layout_marginTop="24dp" android:text="@string/home_pz" />

        <LinearLayout android:id="@+id/rowReceivers" style="@style/SettingsRow">
            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_receivers" />
            <TextView android:id="@+id/receiversValue" style="@style/SettingsRowValue" />
        </LinearLayout>

        <TextView style="@style/SettingsGroupHeader" android:layout_marginTop="24dp" android:text="@string/settings_general" />

        <LinearLayout android:id="@+id/rowServer" style="@style/SettingsRow">
            <TextView style="@style/SettingsRowTitle" android:text="@string/server_settings" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowUpdates" style="@style/SettingsRow" android:layout_marginTop="10dp">
            <TextView style="@style/SettingsRowTitle" android:text="@string/update_check" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/resetButton"
        style="@style/Widget.Skaner.Button.Danger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp"
        android:text="@string/settings_reset" />

    <TextView
        android:id="@+id/versionValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
