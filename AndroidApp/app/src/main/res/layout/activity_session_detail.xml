<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_blue"
        android:elevation="4dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@android:color/white"
        app:titleTextColor="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <include android:id="@+id/totals" layout="@layout/view_document_totals" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/groupSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingVertical="4dp"
            android:text="@string/group_by_alley"
            android:textColor="@color/brand_blue" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/itemsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <ExpandableListView
                android:id="@+id/itemsGrouped"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:childDivider="@null"
                android:clipToPadding="false"
                android:divider="@null"
                android:groupIndicator="@null"
                android:paddingBottom="8dp"
                android:scrollbars="none"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/scanButton"
            style="@style/Widget.Skaner.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/continue_scanning"
            app:icon="@drawable/ic_qr"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/shareCsvButton"
                style="@style/Widget.Skaner.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/share_csv" />

            <Button
                android:id="@+id/saveCsvButton"
                style="@style/Widget.Skaner.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save_csv" />
        </LinearLayout>

        <Button
            android:id="@+id/deleteButton"
            style="@style/Widget.Skaner.Button.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/delete_session" />
    </LinearLayout>

</LinearLayout>
