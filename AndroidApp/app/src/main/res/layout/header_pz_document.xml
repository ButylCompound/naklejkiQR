<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <TextView
        android:id="@+id/scanDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/approvedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:lineSpacingExtra="6dp"
        android:textColor="@color/brand_blue"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/draftHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/supplierInputLayout"
            style="@style/Widget.Skaner.TextInput.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/pz_supplier">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/supplierInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:inputType="none"
                android:background="@null"
                android:paddingHorizontal="16dp"
                android:completionThreshold="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/receiverButton"
            style="@style/Widget.Skaner.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/pz_receiver"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/brand_blue" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/invoiceInputLayout"
            style="@style/Widget.Skaner.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/pz_invoice_optional">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/invoiceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/matchLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:labelFor="@id/matchGroup"
            android:text="@string/pz_delivery_matches"
            android:textColor="@color/brand_blue"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/matchGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/matchYes"
                style="@style/Widget.Skaner.Button.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pz_yes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/matchNo"
                style="@style/Widget.Skaner.Button.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pz_no" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/deliveryCommentInputLayout"
            style="@style/Widget.Skaner.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/pz_delivery_comment"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/deliveryCommentInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:inputType="textMultiLine|textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/backupValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/groupSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingVertical="4dp"
        android:text="@string/pz_group_by_lot"
        android:textColor="@color/brand_blue" />
</LinearLayout>
